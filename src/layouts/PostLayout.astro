---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  author?: string;
  categories?: string;
  tags?: string[];
}
const { title, date, author, categories, tags } = Astro.props;
---
<BaseLayout title={title}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {author && <span class="post-author"> • {author}</span>}
        {categories && <span class="post-categories"> • {categories}</span>}
      </p>
    </header>
    <div class="post-content">
      <slot />
    </div>
    {tags && tags.length > 0 && (
      <footer class="post-footer">
        <ul class="post-tags">
          {tags.map(tag => <li><span class="tag">{tag}</span></li>)}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>
